# FitWeek mobile — local development environment variables
# Copy to .env and fill in values. Never commit .env.

# Supabase (client-safe anon key)
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# API server — production Cloud Run URL (use LAN IP for local api-server dev)
EXPO_PUBLIC_API_BASE_URL=https://fitweek-api-wrh6da45ta-uc.a.run.app

# Store compliance (required for production EAS builds)
EXPO_PUBLIC_PRIVACY_POLICY_URL=https://your-domain.com/privacy
EXPO_PUBLIC_TERMS_URL=https://your-domain.com/terms

# EAS secrets (set via `eas secret:create`, not in .env for CI builds):
# - EXPO_PUBLIC_API_BASE_URL → https://your-service.run.app
# - EXPO_PUBLIC_SUPABASE_URL
# - EXPO_PUBLIC_SUPABASE_ANON_KEY
# - EXPO_PUBLIC_PRIVACY_POLICY_URL
# - EXPO_PUBLIC_TERMS_URL
