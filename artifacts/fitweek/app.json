{
  "expo": {
    "name": "FitWeek",
    "slug": "fitweek",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "fitweek",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#F7F5F2"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.fitweek.app"
    },
    "android": {
      "package": "com.fitweek.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/icon.png",
        "backgroundColor": "#F7F5F2"
      }
    },
    "web": {
      "favicon": "./assets/images/icon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-web-browser",
      [
        "expo-image-picker",
        {
          "photosPermission": "FitWeek needs access to your photo library to add garments to your closet.",
          "cameraPermission": "FitWeek needs your camera to photograph garments and capture your model photo."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "FitWeek uses your location to fetch an accurate local weather forecast for outfit suggestions."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon.png",
          "color": "#F7F5F2"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
