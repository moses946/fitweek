# API server environment variables (local dev)
# Copy to .env — never commit .env with real secrets.

PORT=8080
NODE_ENV=development

# Supabase (server-side)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Database — use pool URL for runtime, direct URL for migrations
DATABASE_POOL_URL=postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres

# Optional feature keys
OWM_API_KEY=
GOOGLE_CLOUD_VISION_API_KEY=
RESET_PASSWORD_REDIRECT_URL=fitweek://auth/callback

# Logging
LOG_LEVEL=info
